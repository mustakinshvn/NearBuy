# Database Configuration
# PostgreSQL connection string (Neon, AWS RDS, or local)
DATABASE_URL = postgresql://user:password@host:port/database

# Server Configuration
# Port number for the Express server
PORT = 5000

# Cloudinary image upload configuration
CLOUDINARY_CLOUD_NAME = your_cloud_name
CLOUDINARY_API_KEY = your_api_key
CLOUDINARY_API_SECRET = your_api_secret
# Optional Cloudinary folder prefix for uploaded assets
CLOUDINARY_FOLDER = nearbuy

# Environment (development, production, testing)
NODE_ENV = development

# Frontend URLs (for CORS policy)
# Production frontend URL
FRONTEND_URL = http://localhost:5173

# Development frontend URL
FRONTEND_URL_DEV = http://localhost:5173
